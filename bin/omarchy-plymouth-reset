#!/bin/bash

# omarchy:summary=Restore the default Omarchy Plymouth boot theme and SDDM login screen
# omarchy:requires-sudo=true

# Both restores go through the hardened fixed-file publisher (omarchy-plymouth-set,
# via the refresh wrappers): each destination is replaced atomically without
# following an existing symlink, the full packaged asset set is published
# (including logos/), and the Plymouth refresh rebuilds the initramfs. Run each
# as a child so refresh-plymouth's exec does not stop us before refresh-sddm.
omarchy-refresh-plymouth && omarchy-refresh-sddm
