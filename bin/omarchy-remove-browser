#!/bin/bash

# omarchy:summary=Remove a supported browser and clean up Omarchy browser defaults
# omarchy:args=<chromium|chrome|brave|firefox|zen>
# omarchy:examples=omarchy remove browser firefox | omarchy remove browser brave

set_fallback_default_browser() {
  local removed_desktop="$1"
  local current
  current=$(env -u BROWSER xdg-settings get default-web-browser)

  if [[ $current != "$removed_desktop" ]]; then
    return
  fi

  # Fall back to Chromium - unless Chromium itself is the browser being removed, which would
  # leave the default pointing at a desktop file we are about to uninstall.
  if [[ $removed_desktop != "org.chromium.Chromium.desktop" ]] && omarchy-flatpak-present org.chromium.Chromium; then
    env -u BROWSER xdg-settings set default-web-browser org.chromium.Chromium.desktop || true
  fi
}

case $1 in
chromium) appid="org.chromium.Chromium"; name="Chromium" ;;
chrome) appid="com.google.Chrome"; name="Chrome" ;;
brave) appid="com.brave.Browser"; name="Brave" ;;
firefox) appid="org.mozilla.firefox"; name="Firefox" ;;
zen) appid="app.zen_browser.zen"; name="Zen" ;;
*)
  echo "Usage: omarchy-remove-browser <chromium|chrome|brave|firefox|zen>"
  exit 1
  ;;
esac

echo "Removing $name..."
set_fallback_default_browser "$appid.desktop"
# Browsers are installed per-user (see omarchy-install-browser); drop the app and its data.
flatpak uninstall -y --user --delete-data "$appid"
