#!/bin/bash

# omarchy:summary=Install a supported browser as a Flatpak from Flathub
# omarchy:args=<chromium|chrome|brave|firefox|zen>
# omarchy:examples=omarchy install browser firefox | omarchy install browser brave

install_flatpak_browser() {
  # Browsers install per-user from Flathub, so no privilege escalation is needed. The
  # system-wide Chromium baked into the image is still seen by `flatpak info`/`omarchy-flatpak-present`.
  flatpak install -y --user flathub "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 installed. Make it the default via Setup > Defaults > Browser."
}

setup_chromium_family() {
  local appid="$1"
  local flagfile="$2"
  local config="$HOME/.var/app/$appid/config"

  # Chromium-family Flatpaks read *-flags.conf and managed policies from their per-user
  # config tree, so drop the Omarchy flags there rather than in ~/.config.
  mkdir -p "$config"
  cp -f "$OMARCHY_PATH/config/chromium-flags.conf" "$config/$flagfile"

  # Let the sandboxed browser reach the Omarchy native-messaging hosts (Copy URL, yt-dlp),
  # which live under $OMARCHY_PATH. Best-effort: harmless if the override cannot be set.
  flatpak override --user --filesystem="$OMARCHY_PATH:ro" "$appid" 2>/dev/null || true

  omarchy-install-chromium-copy-url
  omarchy-install-chromium-ytdlp
  omarchy-theme-set-browser
}

case $1 in
chromium)
  echo "Installing Chromium..."
  install_flatpak_browser org.chromium.Chromium || exit 1
  setup_chromium_family org.chromium.Chromium chromium-flags.conf
  announce_browser_installed "Chromium"
  ;;
chrome)
  echo "Installing Chrome..."
  install_flatpak_browser com.google.Chrome || exit 1
  setup_chromium_family com.google.Chrome chrome-flags.conf
  announce_browser_installed "Chrome"
  ;;
brave)
  echo "Installing Brave..."
  install_flatpak_browser com.brave.Browser || exit 1
  setup_chromium_family com.brave.Browser brave-flags.conf
  announce_browser_installed "Brave"
  ;;
firefox)
  echo "Installing Firefox..."
  # The Flatpak already runs natively on Wayland and ships its own defaults; nothing else to wire.
  install_flatpak_browser org.mozilla.firefox || exit 1
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  install_flatpak_browser app.zen_browser.zen || exit 1
  announce_browser_installed "Zen"
  ;;
*)
  echo "Usage: omarchy-install-browser <chromium|chrome|brave|firefox|zen>"
  exit 1
  ;;
esac
