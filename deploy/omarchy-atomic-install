#!/usr/bin/env bash
# Plain-bootc install of omarchy-atomic onto a running Fedora Asahi system (Apple Silicon).
#
# Uses `bootc install to-existing-root --composefs-backend --bootloader systemd` — NO rpm-ostree,
# NO bootupd. bootc lays down the OS + systemd-boot (the OS bootloader at /EFI/BOOT/BOOTAA64.EFI);
# this wrapper preserves EVERYTHING on the ESP that bootc doesn't manage — bootc owns only EFI/
# (systemd-boot); the rest is the Asahi preboot + install-identity layer:
#   <ESP>/m1n1/boot.bin  (m1n1 stage 2 + U-Boot + DTB)      <ESP>/vendorfw/  (per-machine firmware)
#   <ESP>/asahi/  (firmware source + stub/VGID identity)     <ESP>/ubootefi.var  (U-Boot NVRAM store)
# The Apple stub / m1n1 stage 1 are never touched (Linux can't reach them without 1TR).
#
# Boot chain after install:
#   Apple iBoot -> m1n1 s1 (stub) -> m1n1 s2 (boot.bin) -> U-Boot -> systemd-boot -> kernel
#
# The proper m1n1/DT refresh (matching the NEW kernel) is done on first boot by
# omarchy-apply-m1n1.service, which runs update-m1n1 from the new image's /usr. This wrapper
# only guarantees the machine boots at all after reboot (restores the known-good boot.bin).
#
# This wrapper also GROWS the ESP before installing. The Asahi installer puts kernels on a separate
# 1 GiB /boot that the composefs backend never uses, so an un-grown 500 MiB ESP installs fine and
# then can never `bootc upgrade` (the second deployment's kernel doesn't fit — ENOSPC). It folds
# that /boot in via omarchy-atomic-grow-esp. If the kernel can't adopt the new partition table
# without a reboot, it stops and asks you to reboot and re-run this command — the grow resumes and
# the install continues.
#
# USAGE (as root, on a Fedora Asahi aarch64 host — NOT your daily driver; test install):
#   sudo deploy/omarchy-atomic-install ghcr.io/olirafa/omarchy-atomic:44
set -euo pipefail

# ESP copy/replace helpers — the risky part of this wrapper, e2e-tested off-hardware in
# deploy/tests/esp-backup.test.sh (the same esp_backup/esp_restore run here).
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/esp-backup.sh
. "$_here/lib/esp-backup.sh"
# ESP capacity arithmetic — the composefs backend puts kernels ON the ESP; see the header there.
# shellcheck source=lib/esp-capacity.sh
. "$_here/lib/esp-capacity.sh"

IMAGE="${1:?usage: omarchy-atomic-install <image-ref>   e.g. ghcr.io/olirafa/omarchy-atomic:44}"
[ "$(id -u)" = 0 ]         || { echo "run as root"; exit 1; }
[ "$(uname -m)" = aarch64 ] || { echo "aarch64 (Apple Silicon) only"; exit 1; }
command -v podman >/dev/null || { echo "podman required (bootc install reads /var/lib/containers)"; exit 1; }
[ -e /proc/device-tree/chosen/asahi,efi-system-partition ] || \
  { echo "no asahi,efi-system-partition — is this a Fedora Asahi (Apple Silicon) system?"; exit 1; }

# The host must be Fedora: README and deploy/README both list Arch/Asahi Alarm as unsupported,
# and nothing here is tested against a pacman root. `bootc install to-existing-root` will happily
# lay the image down on one anyway and report success, so refuse up front.
#
# What an Arch host costs you when the boot then goes wrong is visibility: if the initramfs does
# not pivot into the deployment, / stays the host's own root, and you boot the IMAGE's kernel
# against the HOST's /usr/lib/modules. On Arch that means no module loads at all, the ESP's
# genfstab-written `iocharset=iso8859-1` can't be resolved, and local-fs.target drops you into
# emergency mode. NOTE: the pivot failing is a separate bug from the host check — a Fedora host
# hits it too, it just fails quietly (old Fedora userland, new kernel) instead of loudly.
host_id="$(sed -n 's/^ID=//p' /etc/os-release 2>/dev/null | tr -d '"' | head -1 || true)"
# Fedora Asahi Remix reports ID=fedora-asahi-remix (with ID_LIKE=fedora), not a bare ID=fedora, so
# match "fedora" as a whole token across ID and ID_LIKE. This still refuses a pacman root (ID=arch),
# the case this check exists to catch.
host_id_like="$(sed -n 's/^ID_LIKE=//p' /etc/os-release 2>/dev/null | tr -d '"' | head -1 || true)"
if [[ " $host_id $host_id_like " != *" fedora "* ]]; then
  echo "host OS is '${host_id:-unknown}', not Fedora Asahi Remix — refusing to install." >&2
  echo "  This path is only supported and tested on Fedora Asahi Remix. bootc will install onto" >&2
  echo "  a pacman root and report success, then boot this image's kernel against the host's own" >&2
  echo "  modules if the initramfs does not pivot — leaving you in emergency mode." >&2
  echo "  Install Fedora Asahi Remix as a second OS (Apple boot picker) and run this there." >&2
  exit 1
fi

# 1) Identify the OS ESP the way m1n1 does (authoritative), independent of any mount.
esp_uuid="$(tr -d '\0' </proc/device-tree/chosen/asahi,efi-system-partition 2>/dev/null || true)"
esp_dev="$(blkid -t "PARTUUID=$esp_uuid" -o device 2>/dev/null || true)"
[[ -n $esp_dev ]] || esp_dev="$(findmnt -no SOURCE /boot/efi 2>/dev/null || true)"

# The rest of this wrapper reaches the ESP through a mount, but on the composefs layout the ESP is
# normally mounted nowhere, and the grow step below unmounts it. So mount it on demand rather than
# assuming /boot/efi, and unmount a mount we made on the way out.
esp="" esp_tmp_mnt=""
mount_os_esp() {
  local m
  m="$(findmnt -no TARGET "$esp_dev" 2>/dev/null | head -1 || true)"
  if [[ -n $m ]]; then
    esp="$m"
  else
    [[ -b $esp_dev ]] || { echo "no device node for the OS ESP (${esp_dev:-unknown}) — cannot continue" >&2; exit 1; }
    esp_tmp_mnt="$(mktemp -d)"
    mount "$esp_dev" "$esp_tmp_mnt" || { echo "could not mount the OS ESP $esp_dev" >&2; exit 1; }
    esp="$esp_tmp_mnt"
  fi
}
cleanup_esp_mount() {
  [[ -n $esp_tmp_mnt ]] || return 0
  sync
  umount "$esp_tmp_mnt" 2>/dev/null || true
  rmdir "$esp_tmp_mnt" 2>/dev/null || true
}
trap cleanup_esp_mount EXIT

# 1b) Fold the unused /boot into the ESP so the composefs backend has room for TWO deployments'
#     kernels. Without this every install succeeds and then can never `bootc upgrade` (ENOSPC); see
#     deploy/lib/esp-capacity.sh. The Asahi installer puts kernels on a separate 1 GiB ext4 /boot
#     that omarchy-atomic never uses, so it is exactly the space the ESP is missing and it sits
#     directly after it. Every stock install needs this, so drive it here rather than leaving it a
#     manual pre-step. All the dangerous work — GPT surgery with the ESP's PARTUUID preserved,
#     backup/reformat/restore, boot-entry repair — lives in omarchy-atomic-grow-esp; this only picks
#     the target and handles its "needs a reboot" outcome.
grow_state="/var/tmp/omarchy-atomic-grow.absorb"
absorb=""
if [[ -e $grow_state ]]; then
  # Resuming after grow-esp asked for a reboot: /boot is already gone from the table, so trust the
  # target it recorded rather than looking for a partition that no longer exists.
  absorb="$(< "$grow_state")"
  echo "==> resuming a pending ESP grow (recorded target: $absorb)"
else
  boot_src="$(findmnt -no SOURCE /boot 2>/dev/null || true)"
  if [[ -n $esp_dev && -n $boot_src && $boot_src != "$esp_dev" ]]; then
    absorb="$boot_src"
  fi
fi

if [[ -n $absorb ]]; then
  # grow-esp needs the absorbed partition unmounted, and on a stock system the ESP is mounted UNDER
  # it at /boot/efi — detach the whole /boot subtree first (that drops our ESP mount too; grow-esp
  # remounts the ESP itself as it needs).
  if findmnt -no TARGET /boot >/dev/null 2>&1; then
    umount -R /boot || { echo "could not unmount /boot to fold it into the ESP — close anything using it" >&2; exit 1; }
  fi

  printf '%s\n' "$absorb" >"$grow_state"
  echo "==> growing the OS ESP by absorbing $absorb (deploy/omarchy-atomic-grow-esp)"
  set +e
  "$_here/omarchy-atomic-grow-esp" --absorb "$absorb" --yes --backup-dir /var/tmp/asahi-esp-grow-backup
  grow_rc=$?
  set -e
  case $grow_rc in
    0) rm -f "$grow_state"; echo "==> ESP grown" ;;
    2)
      echo >&2
      echo "The ESP table was rewritten but the kernel could not adopt it while the root filesystem" >&2
      echo "  is mounted on the same disk. Nothing about the OS has been installed yet — reboot and" >&2
      echo "  re-run this exact command; it resumes the grow and then installs:" >&2
      echo "    sudo reboot" >&2
      echo "    sudo $0 $IMAGE" >&2
      exit 2 ;;
    *)
      echo "omarchy-atomic-grow-esp failed (exit $grow_rc) — refusing to install onto an ESP that is" >&2
      echo "  too small to ever update. Nothing has been installed; any ESP backup is at" >&2
      echo "  /var/tmp/asahi-esp-grow-backup." >&2
      exit 1 ;;
  esac
fi

# 1c) Mount the (now grown) OS ESP for the backup + install + restore below.
mount_os_esp
echo "==> OS ESP: $esp  (asahi,efi-system-partition=$esp_uuid, dev=${esp_dev:-?})"

# Not a warning: bootc's --replace=alongside wipes the WHOLE ESP, and m1n1 stage 2 is what U-Boot
# loads. Backing up an ESP that doesn't hold it leaves nothing to restore and the machine does not
# come back. If this fires, $esp is probably not where the OS ESP is mounted.
if [[ ! -e $esp/m1n1/boot.bin ]]; then
  echo "$esp/m1n1/boot.bin not found — refusing to continue." >&2
  echo "  bootc wipes the entire ESP; without m1n1/boot.bin in the backup there is no stage 2 to" >&2
  echo "  restore afterwards and the machine will not boot. Check what is really mounted there:" >&2
  echo "    findmnt $esp; ls -R $esp | head" >&2
  echo "  Set OMARCHY_ESP_FORCE=1 only if you have confirmed m1n1 lives elsewhere." >&2
  if [[ ${OMARCHY_ESP_FORCE:-0} != "1" ]]; then
    exit 1
  fi
fi

# 2) Back up the ENTIRE ESP (bootc may reinitialize it). We can't know up front whether bootc
#    reformats the ESP or writes into it, so snapshot the whole thing — m1n1, vendorfw, asahi/
#    (firmware source + VGID identity), ubootefi.var, everything. Only EFI/ (systemd-boot) is
#    bootc's to (re)create; we never restore that over what bootc writes.
bk="/var/tmp/asahi-esp-backup"
esp_backup "$esp" "$bk"
echo "==> backed up entire ESP ($esp) -> $bk"

# 3) Plain bootc install (composefs-native + systemd-boot; no rpm-ostree, no bootupd).
#    A locally built image (./images/build.sh leaves localhost/omarchy-atomic:<fedora>) has nothing
#    to pull and no registry to fetch-check against, so skip both when the ref already resolves.
#    It must be ROOT's storage: this runs under sudo and bind-mounts /var/lib/containers, while a
#    rootless build lands in ~/.local/share/containers. Move one over with
#    `podman image scp localhost/omarchy-atomic:44 root@localhost::` before running this.
#    NOTE: installing from a localhost ref records it as the deployment origin, so a later
#    `bootc upgrade` has nowhere to pull from. Add --target-imgref <registry ref> below if you
#    want the machine to track GHCR after a local test install.
fetch_check=()
if podman image exists "$IMAGE"; then
  echo "==> using local image $IMAGE (no pull, no fetch check)"
  fetch_check=(--skip-fetch-check)
elif [[ $IMAGE == localhost/* ]]; then
  # Fail here rather than let `podman run` fall back to pulling it: a localhost ref sends podman
  # to a registry literally named "localhost", which ends in a confusing connection-refused loop.
  echo "$IMAGE is not in root's container storage — refusing to install." >&2
  echo "  A rootless build lands in ~/.local/share/containers; this runs under sudo and reads" >&2
  echo "  /var/lib/containers. Move the image across, then re-run:" >&2
  echo "    podman image scp $IMAGE root@localhost::" >&2
  exit 1
else
  echo "==> pulling $IMAGE"
  podman pull "$IMAGE"
fi

# 3b) ESP capacity. The composefs backend writes vmlinuz + initrd into <ESP>/EFI/Linux/ and finds
#     the ESP by GPT type GUID — a separate /boot is never used (open upstream TODO; confirmed on
#     hardware against a correctly typed, mounted XBOOTLDR). The Asahi installer sizes the ESP for
#     m1n1 + U-Boot + GRUB, not for kernels, so the INSTALL fits and every later `bootc upgrade`
#     dies with ENOSPC once a second deployment has to coexist with the booted one. Measure the
#     image's own payload rather than guessing: source this same library inside the image so there
#     is one implementation of the arithmetic.
image_payload="$(podman run --rm --entrypoint /bin/bash "$IMAGE" -c \
  "$(cat "$_here/lib/esp-capacity.sh"); esp_payload_bytes" 2>/dev/null || echo 0)"
if [[ ${image_payload:-0} -gt 0 ]]; then
  esp_usable="$(esp_usable_bytes "$esp")"
  esp_needed="$(esp_required_bytes "$image_payload")"
  if ! esp_capacity_report "$esp_usable" "$esp_needed" "$image_payload"; then
    echo >&2
    echo "$esp is too small for two deployments — this install would succeed and then never" >&2
    echo "  be able to update: 'bootc upgrade' writes the new kernel + initrd alongside the" >&2
    echo "  booted one and fails with 'Writing initrd to path: No space left on device'." >&2
    echo "  Fix it first by folding the (unused under composefs) /boot partition into the ESP:" >&2
    echo "    findmnt /boot          # note the device, then: umount /boot" >&2
    echo "    deploy/omarchy-atomic-grow-esp --absorb <that device> --dry-run" >&2
    echo "  Set OMARCHY_ESP_SMALL_OK=1 to install anyway (upgrades will need the ESP grown)." >&2
    if [[ ${OMARCHY_ESP_SMALL_OK:-0} != "1" ]]; then
      exit 1
    fi
    echo "==> OMARCHY_ESP_SMALL_OK=1 — continuing with an undersized ESP" >&2
  fi
else
  echo "==> could not measure $IMAGE's kernel payload — skipping the ESP capacity check" >&2
fi

echo "==> bootc install to-existing-root from $IMAGE"
podman run --rm --privileged --pid=host --security-opt label=type:unconfined_t \
  -v /dev:/dev -v /var/lib/containers:/var/lib/containers -v /:/target \
  "$IMAGE" \
  bootc install to-existing-root --composefs-backend --bootloader systemd \
    --acknowledge-destructive "${fetch_check[@]}"

# 4) Guarantee bootability + preserve Asahi identity: restore every backed-up ESP entry that
#    bootc removed — EXCEPT EFI/, which bootc just wrote systemd-boot into (never overwrite it).
#    If bootc wrote into the ESP without reformatting, each entry still exists and is left as-is.
#    (Do NOT run update-m1n1 here — the host /usr is still the OLD OS; the correct refresh from
#    the NEW image happens on first boot via omarchy-apply-m1n1.service.)
esp_restore "$esp" "$bk"

echo
echo "==> DONE.  Reboot to switch. On first boot, omarchy-apply-m1n1.service refreshes boot.bin"
echo "    for the new kernel (a second reboot applies a changed devicetree). Old system is at /sysroot."
echo "    Recovery: the full ESP backup is at $bk (root fs) — restore m1n1/boot.bin from there, or"
echo "    mount the ESP from macOS 1TR, if the machine won't boot."
