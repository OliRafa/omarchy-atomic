#!/bin/bash

# omarchy:summary=Set the default browser for Omarchy and XDG handlers
# omarchy:args=[chromium|chrome|brave|firefox|zen]
# omarchy:examples=omarchy default browser firefox | omarchy default browser brave

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

if (($# == 0)); then
  case "$(env -u BROWSER xdg-settings get default-web-browser)" in
  org.chromium.Chromium.desktop) echo "chromium" ;;
  com.google.Chrome.desktop) echo "chrome" ;;
  com.brave.Browser.desktop) echo "brave" ;;
  org.mozilla.firefox.desktop) echo "firefox" ;;
  app.zen_browser.zen.desktop) echo "zen" ;;
  *) env -u BROWSER xdg-settings get default-web-browser ;;
  esac
  exit 0
fi

case "$1" in
chromium) browser="chromium"; appid="org.chromium.Chromium"; name="Chromium"; glyph= ;;
chrome) browser="chrome"; appid="com.google.Chrome"; name="Chrome"; glyph=󰊯 ;;
brave) browser="brave"; appid="com.brave.Browser"; name="Brave"; glyph=󰖟 ;;
firefox) browser="firefox"; appid="org.mozilla.firefox"; name="Firefox"; glyph=󰈹 ;;
zen) browser="zen"; appid="app.zen_browser.zen"; name="Zen"; glyph=󰖟 ;;
*)
  echo "Usage: omarchy-default-browser <chromium|chrome|brave|firefox|zen>"
  exit 1
  ;;
esac

desktop_id="$appid.desktop"

if ! omarchy-flatpak-present "$appid"; then
  if [[ $installing == "false" ]]; then
    exec omarchy-launch-floating-terminal-with-presentation omarchy-default-browser --install "$browser"
  else
    omarchy-install-browser "$browser" || exit 1
  fi
fi

env -u BROWSER xdg-settings set default-web-browser "$desktop_id" || exit 1

omarchy-notification-send -g $glyph "$name is now the default browser"
