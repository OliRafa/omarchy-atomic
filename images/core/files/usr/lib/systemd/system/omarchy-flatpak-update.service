[Unit]
Description=Update system Flatpaks (apps, runtimes, appstream)
Documentation=man:flatpak-update(1)
ConditionPathExists=/usr/bin/flatpak
# Needs a real network; keep the hint even though wait-online is masked here — the timer re-fires, so
# a run that lands before the network is up is simply skipped by the check below and retried later.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Skip on a metered connection so a phone hotspot is not silently drained — the same guard ublue and
# bluefin put on their flatpak update units. NMMetered: 1=yes, 3=guess-yes, 2=no, 4=guess-no, 0=unknown.
# Proceed unless KNOWN-metered (1/3): if the property can't be read the string is empty and we still
# update, because a system whose Flatpaks otherwise never update is the worse failure.
ExecCondition=/usr/bin/bash -c 'm=$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered 2>/dev/null | cut -c 3-); [[ $m != 1 && $m != 3 ]]'
# --appstream is implied by a plain update, but pull it explicitly first so the store metadata is
# fresh even if an app update later fails. Then update apps + runtimes, then reclaim unused runtimes.
ExecStart=/usr/bin/flatpak update --system --appstream -y --noninteractive
ExecStart=/usr/bin/flatpak update --system -y --noninteractive
ExecStartPost=-/usr/bin/flatpak uninstall --system --unused -y --noninteractive
