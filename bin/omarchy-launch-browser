#!/bin/bash

# omarchy:summary=Launch the default browser as determined by xdg-settings.
# omarchy:args=[url]
desktop_paths=(
  "$HOME/.local/share/applications"
  "$HOME/.local/share/flatpak/exports/share/applications"
  "$HOME/.nix-profile/share/applications"
  "/usr/local/share/applications"
  "/usr/share/applications"
  "/var/lib/flatpak/exports/share/applications"
)

resolve_desktop_file() {
  local desktop_id="$1"

  for base in "${desktop_paths[@]}"; do
    if [[ -f "$base/$desktop_id" ]]; then
      printf "%s\n" "$base/$desktop_id"
      return 0
    fi
  done

  return 1
}

resolve_exec() {
  local desktop_id="$1"
  local file
  local exec_line

  file="$(resolve_desktop_file "$desktop_id")" || return 1
  exec_line="$(sed -n 's/^Exec=//p' "$file" | head -n1)"
  exec_line="${exec_line%% *}"
  [[ -n "$exec_line" ]] || return 1
  printf "%s\n" "$exec_line"
}

pick_desktop_id() {
  local configured
  local candidate

  configured="$(xdg-settings get default-web-browser 2>/dev/null || true)"
  if [[ -n "$configured" ]] && resolve_desktop_file "$configured" >/dev/null; then
    printf "%s\n" "$configured"
    return 0
  fi

  for candidate in \
    org.chromium.Chromium.desktop \
    com.brave.Browser.desktop \
    com.google.Chrome.desktop \
    org.mozilla.firefox.desktop \
    app.zen_browser.zen.desktop \
    chromium-browser.desktop \
    chromium.desktop \
    google-chrome.desktop \
    brave-browser.desktop \
    firefox.desktop; do
    if resolve_desktop_file "$candidate" >/dev/null; then
      printf "%s\n" "$candidate"
      return 0
    fi
  done

  return 1
}

private_flag_for() {
  # Firefox-family browsers use --private-window; Chromium-family use --incognito.
  case "$1" in
  *[Ff]irefox* | *[Zz]en*) printf "%s\n" "--private-window" ;;
  *) printf "%s\n" "--incognito" ;;
  esac
}

want_private=false
pass_args=()
for arg in "$@"; do
  if [[ "$arg" == "--private" ]]; then
    want_private=true
  else
    pass_args+=("$arg")
  fi
done

browser_exec=""
desktop_id="$(pick_desktop_id 2>/dev/null || true)"
if [[ -n "$desktop_id" ]]; then
  browser_exec="$(resolve_exec "$desktop_id" 2>/dev/null || true)"
fi

# Flatpak browsers resolve Exec to `flatpak run <app-id> ...`; the app-id is the desktop-file
# stem. Launch through flatpak directly, otherwise our flags would be handed to flatpak itself.
if [[ "$(basename -- "$browser_exec")" == "flatpak" && -n "$desktop_id" ]]; then
  appid="${desktop_id%.desktop}"
  if [[ "$want_private" == true ]]; then
    pass_args=("$(private_flag_for "$appid")" "${pass_args[@]}")
  fi
  exec setsid uwsm-app -- flatpak run "$appid" "${pass_args[@]}"
fi

if [[ -z "$browser_exec" ]]; then
  for candidate in chromium-browser chromium firefox google-chrome brave-browser; do
    if omarchy-cmd-present "$candidate"; then
      browser_exec="$candidate"
      break
    fi
  done
fi

if [[ -z "$browser_exec" ]]; then
  notify-send "Browser" "No supported browser found. Install one from Install > Browser."
  exit 1
fi

if [[ "$want_private" == true ]]; then
  if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
    pass_args=("--private-window" "${pass_args[@]}")
  else
    pass_args=("--incognito" "${pass_args[@]}")
  fi
fi

exec setsid uwsm-app -- "$browser_exec" "${pass_args[@]}"
