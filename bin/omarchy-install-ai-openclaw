#!/bin/bash

# omarchy:summary=Install the OpenClaw agent platform and its Control UI web app

set -e

echo "Installing OpenClaw..."
# OpenClaw is the mise-backed npm:openclaw tool (the CLI, the gateway, and the
# Control UI web app all share it). The wrapper installs on first use.
omarchy-install-openclaw-cli --now

# The desktop app is OpenClaw's Control UI: a web app served by its own gateway.
# The launcher goes through omarchy-launch-openclaw, which onboards or starts
# that gateway before opening the window.
echo "Installing the OpenClaw web app..."
# The Control UI icon ships inside the npm package. The mise wrapper installs
# lazily, so the package may not be unpacked yet; use the packaged icon when it
# is already on disk, otherwise fall back to a generic launcher name so the web
# app still installs (a branded icon lands on the next reinstall once OpenClaw
# has run at least once).
icon=openclaw
pkg_root=$(mise where npm:openclaw 2>/dev/null || true)
if [[ -n $pkg_root ]]; then
  found=$(find "$pkg_root" -type f -path '*/openclaw/dist/control-ui/apple-touch-icon.png' 2>/dev/null | head -1)
  [[ -n $found ]] && icon=$found
fi
omarchy-webapp-install OpenClaw "http://127.0.0.1:18789" "$icon" omarchy-launch-openclaw

# A first install runs onboarding right here: launching the app instead would
# open a second floating terminal for the wizard, identical to this one.
# omarchy-openclaw-onboard runs the wizard the way this flow needs (terminal
# prompts, gateway as a user service, and it actually returns), and this is also
# the first `openclaw` run, which materializes the mise install. A machine that
# is already onboarded goes straight to the app.
if [[ -f $HOME/.openclaw/openclaw.json ]]; then
  echo "Opening OpenClaw..."
  setsid uwsm-app -- gtk-launch OpenClaw >/dev/null 2>&1 &
elif omarchy-openclaw-onboard && [[ -f $HOME/.openclaw/openclaw.json ]]; then
  echo "Opening OpenClaw..."
  setsid uwsm-app -- gtk-launch OpenClaw >/dev/null 2>&1 &
fi

echo ""
echo "OpenClaw has been installed."
echo "If you skipped onboarding, launching OpenClaw from the app grid resumes it."
