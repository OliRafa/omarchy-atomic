#!/bin/bash

# omarchy:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Omarchy default and rebuild it.
# omarchy:requires-sudo=true

# Reuse the hardened fixed-file publisher so root never resolves an untrusted
# source or follows a destination symlink while restoring the packaged theme,
# then rebuilds the initramfs (dracut on this fork).
exec "$OMARCHY_PATH/bin/omarchy-plymouth-set" --refresh-default
