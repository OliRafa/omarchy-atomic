#!/bin/bash

# omarchy:summary=Install one of the approved terminals and set it as the default for Omarchy (Super + Return etc).
# omarchy:args=<foot|kitty>
# omarchy:requires-sudo=true

if (($# == 0)); then
  echo "Usage: omarchy-install-terminal [foot|kitty]"
  exit 1
fi

package="$1"

# Map terminal name to its desktop entry ID.
case "$package" in
foot) desktop_id="foot.desktop" ;;
kitty) desktop_id="kitty.desktop" ;;
*)
  echo "Unknown terminal: $package"
  echo "Omarchy installs foot (native, the default) and kitty (Homebrew). Alacritty and Ghostty are"
  echo "not published on Flathub or Homebrew for Linux, so installing them is your job - see the manual."
  exit 1
  ;;
esac

echo "Installing $package..."

install_terminal_package() {
  case "$1" in
  # foot is the shipped default and part of the base image; reinstall it natively if it is missing.
  foot) omarchy-pkg-add foot ;;
  # kitty is delivered via Homebrew - its brew cask ships a real Linux binary, so no sudo is needed.
  kitty) brew install --cask kitty ;;
  esac
}

if install_terminal_package "$package"; then
  # Ship the terminal's desktop entry (with the X-TerminalArg* keys xdg-terminal-exec needs). The
  # Homebrew kitty cask keeps its own desktop file inside the Caskroom, off XDG_DATA_DIRS, so we
  # provide one that resolves `kitty` through the Homebrew PATH.
  mkdir -p ~/.local/share/applications
  cp "$OMARCHY_PATH/applications/$desktop_id" ~/.local/share/applications/

  # Copy the default config for the terminal when the user has none.
  if [[ ! -e ~/.config/$package ]]; then
    cp -Rpf "$OMARCHY_PATH/config/$package" ~/.config/
  fi

  # Prioritize the chosen terminal for xdg-terminal-exec.
  cat >~/.config/xdg-terminals.list <<EOF
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
$desktop_id
EOF
else
  echo "Failed to install $package"
  exit 1
fi
