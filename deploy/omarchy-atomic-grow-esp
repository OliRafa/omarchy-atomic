#!/usr/bin/env bash
# Grow the Asahi ESP by absorbing the partition that follows it, so bootc's composefs backend has
# room for two deployments' kernels and initramfses.
#
# WHY THIS EXISTS
#   bootc's composefs backend writes vmlinuz + initrd into <ESP>/EFI/Linux/bootc_composefs-<id>/,
#   and it finds the ESP by GPT TYPE GUID — a separate /boot is never consulted. Supporting a
#   dedicated boot partition is an open upstream TODO ("bootc does not yet detect or use XBOOTLDR
#   in the composefs install path", crates/lib/src/bootc_composefs/boot.rs), confirmed on hardware:
#   a correctly typed, VFAT, mounted-at-/boot XBOOTLDR partition with 1 GiB free changed nothing —
#   `bootc upgrade` still wrote to the 500 MiB ESP and died with ENOSPC.
#
#   The Asahi installer sizes the ESP for m1n1 + U-Boot + GRUB (500 MiB, ~126 MiB of it already
#   preboot) and puts kernels on a separate 1 GiB ext4 /boot, because that is what the stock
#   ostree + GRUB layout wants. An omarchy-atomic machine does not use that /boot at all — so it
#   is exactly the space the ESP is missing. This tool moves it across.
#
# ORDER OF OPERATIONS (each phase is separately resumable — re-running is safe and expected)
#   0. Repoint any boot entry that names a partition other than the ESP, BEFORE anything is
#      destroyed. A `systemd.mount-extra=UUID=<gone>:/boot:…` karg left behind fails
#      local-fs.target on the next boot and drops you in emergency mode, so it must not survive
#      even a run that aborts halfway.
#   1. Rewrite the GPT from an `sfdisk -d` dump, preserving every PARTUUID verbatim — the Asahi
#      device tree finds m1n1 stage 2 by the ESP's PARTUUID; change it and the Mac stops booting
#      before Linux is reached. Skipped if the table already says what it should.
#   2. Make the kernel adopt the new table. A live root on the same disk means BLKRRPART fails
#      ("Device or resource busy"), so delete the absorbed partition and update the ESP with
#      partx. If the kernel still disagrees, STOP and ask for a reboot rather than mkfs against a
#      stale geometry — by then phase 0 has made rebooting safe.
#   3. Back up the ESP, mkfs.vfat over the grown partition reusing its volume id and label,
#      restore, verify. Skipped if the filesystem already fills the partition.
#
# THIS REWRITES YOUR PARTITION TABLE AND REFORMATS YOUR ESP. Read --dry-run output first, and
# copy the backup off the machine before running for real.
#
# USAGE (as root, on the Asahi machine):
#   omarchy-atomic-grow-esp --absorb /dev/nvme0n1p5 --dry-run
#   omarchy-atomic-grow-esp --absorb /dev/nvme0n1p5
set -euo pipefail

_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/esp-backup.sh
. "$_here/lib/esp-backup.sh"
# shellcheck source=lib/gpt-absorb.sh
. "$_here/lib/gpt-absorb.sh"
# shellcheck source=lib/esp-capacity.sh
. "$_here/lib/esp-capacity.sh"
# shellcheck source=lib/esp-boot-entries.sh
. "$_here/lib/esp-boot-entries.sh"
# shellcheck source=lib/esp-bls-prune.sh
. "$_here/lib/esp-bls-prune.sh"

ABSORB="" DRY_RUN=0 ASSUME_YES=0 PRUNE_ONLY=0 BACKUP_DIR="/var/tmp/asahi-esp-backup"
usage() {
  cat >&2 <<'EOF'
usage: omarchy-atomic-grow-esp --absorb <partition> [--dry-run] [--yes] [--backup-dir DIR]

  --absorb DEV     partition to destroy and fold into the ESP (must directly follow it)
  --prune-only     only remove half-written boot entries from the ESP; no partition surgery
  --dry-run        print the plan and the new partition table; touch nothing
  --yes            skip the interactive confirmations
  --backup-dir DIR where to snapshot the ESP (default: /var/tmp/asahi-esp-backup)

Safe to re-run: each phase is skipped once it has already been done.
EOF
  exit 1
}
while (( $# )); do
  case "$1" in
    --absorb) ABSORB="${2:?--absorb needs a partition}"; shift 2 ;;
    --prune-only) PRUNE_ONLY=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes) ASSUME_YES=1; shift ;;
    --backup-dir) BACKUP_DIR="${2:?--backup-dir needs a path}"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "unknown argument: $1" >&2; usage ;;
  esac
done
if (( ! PRUNE_ONLY )); then
  [[ -n $ABSORB ]] || usage
fi

die() { echo "$@" >&2; exit 1; }

[[ $(id -u) == 0 ]] || die "run as root"
[[ $(uname -m) == "aarch64" ]] || die "aarch64 (Apple Silicon) only"
[[ -e /proc/device-tree/chosen/asahi,efi-system-partition ]] || \
  die "no asahi,efi-system-partition — is this a Fedora Asahi (Apple Silicon) system?"
for c in sfdisk blkid findmnt mkfs.vfat partx blockdev; do
  command -v "$c" >/dev/null || die "$c is required but not installed"
done

# Resolve the ESP the way m1n1 does — by the PARTUUID in the device tree. This is the one thing
# that must survive, and it is also the only identifier that still works when the kernel's idea of
# the disk has gone stale.
#
# Nothing here may trust a device node to exist. BLKRRPART fails whenever any partition on this
# disk is mounted (the root filesystem lives here, so: always), which leaves the kernel holding the
# old table. Worse, a `partx -u` against that stale view can find the grown ESP overlapping a
# partition the kernel still thinks is there, reject the resize, and DROP the ESP's device node
# altogether — observed on hardware: /dev/nvme0n1p4 simply vanished while the GPT on disk was
# perfect. So find the disk by scanning GPTs, and take every fact from `sfdisk -d`.
esp_uuid="$(tr -d '\0' </proc/device-tree/chosen/asahi,efi-system-partition)"
table="$(mktemp)"; new_table="$(mktemp)"
trap 'rm -f "$table" "$new_table"' EXIT

disk=""
for candidate in $(lsblk -dno NAME,TYPE | awk '$2 == "disk" { print "/dev/" $1 }'); do
  if sfdisk -d "$candidate" 2>/dev/null >"$table" && gpt_node_by_uuid "$esp_uuid" "$table" >/dev/null; then
    disk="$candidate"
    break
  fi
done
[[ -n $disk ]] || die "no disk has a partition with PARTUUID=$esp_uuid — cannot identify the ESP"
esp_dev="$(gpt_node_by_uuid "$esp_uuid" "$table")"
esp_partno="$(gpt_partno "$esp_dev")"
on_disk_esp_uuid="$(gpt_field "$esp_dev" uuid "$table")"
echo "==> ESP: $esp_dev on $disk (PARTUUID=$esp_uuid)"

# Apple NVMe reports 4096-byte sectors. Everything below is in sectors; only the human-readable
# sizes need the real figure, and hardcoding 512 made a correct 1.5 GiB resize print as 190 MiB.
sector_size="$(awk '/^sector-size:/ { print $2 }' "$table")"
[[ -n $sector_size ]] || sector_size="$(blockdev --getss "$disk")"
mib() { printf '%s\n' "$(( $1 * sector_size / 1024 / 1024 ))"; }

table_partuuid() { gpt_field "$1" uuid "$table" 2>/dev/null || true; }

# kernel_partitions DISK — "<number> <node>" for every partition the kernel currently has.
kernel_partitions() {
  local base name
  base="$(basename "$1")"
  for name in /sys/block/"$base"/"$base"*; do
    [[ -r $name/partition ]] || continue
    printf '%s /dev/%s\n' "$(cat "$name/partition")" "$(basename "$name")"
  done
}

# reconcile_kernel_partitions DISK — make the kernel's partitions match the on-disk table: drop the
# ones the table no longer has, add the ones it is missing, resize the rest. Deletions come first,
# because a stale partition overlapping a grown one is exactly what makes the resize fail.
reconcile_kernel_partitions() {
  local disk="$1" no node mnt table_nos=" " kernel_nos=" "
  while read -r node; do
    [[ -n $node ]] && table_nos+="$(gpt_partno "$node") "
  done < <(gpt_nodes "$table")

  while read -r no node; do
    [[ -n $no ]] || continue
    kernel_nos+="$no "
    [[ $table_nos == *" $no "* ]] && continue
    mnt="$(findmnt -no TARGET --source "$node" 2>/dev/null || true)"
    [[ -z $mnt ]] || die "the kernel still lists $node (mounted at $mnt) but the partition table
  does not. Unmount it first: umount $mnt"
    echo "==> kernel lists partition $no, which the table no longer has — removing"
    partx -d --nr "$no" "$disk" || die "could not remove stale partition $no from the kernel"
  done < <(kernel_partitions "$disk")

  for no in $table_nos; do
    if [[ $kernel_nos == *" $no "* ]]; then
      partx -u --nr "$no" "$disk" 2>/dev/null || true
    else
      echo "==> partition $no is in the table but not in the kernel — adding"
      partx -a --nr "$no" "$disk" || die "could not add partition $no to the kernel"
    fi
  done
  udevadm settle 2>/dev/null || true
}

# --dry-run promises to touch nothing, and reconciling changes the kernel's partition list (not the
# disk), so it only runs for real. A dry run on a machine whose kernel has lost the ESP's node
# therefore reports that instead of reading the filesystem.
esp_volid="" esp_label=""
if (( DRY_RUN )); then
  if [[ ! -b $esp_dev ]]; then
    echo "==> note: the kernel has no device node for $esp_dev; a real run would add it back" >&2
  fi
else
  reconcile_kernel_partitions "$disk"
  # No node means phase 0 cannot run, so a reboot from here may land in emergency mode on a stale
  # mount-extra karg. Say so rather than cheerfully recommending the reboot.
  [[ -b $esp_dev ]] || die "$esp_dev still has no device node — the kernel would not adopt the
  partition table, so the boot entries cannot be checked. Nothing destructive has happened, but
  do NOT assume a reboot is safe: if an entry still carries systemd.mount-extra for a partition
  that no longer exists, local-fs.target fails and you land in emergency mode. From there:
    mount $esp_dev /mnt && \$EDITOR /mnt/loader/entries/*.conf
  removing the systemd.mount-extra= karg and pointing boot=UUID= at the ESP."
fi

if [[ -b $esp_dev ]]; then
  esp_volid="$(blkid -s UUID -o value "$esp_dev" 2>/dev/null || true)"
  esp_label="$(blkid -s LABEL -o value "$esp_dev" 2>/dev/null || true)"
fi
# The restored boot entries say `boot=UUID=<fat serial>`, and mkfs.vfat invents a fresh one unless
# given it. Without the old serial to hand back we would silently orphan every entry.
if (( ! DRY_RUN )); then
  [[ -n $esp_volid ]] || die "could not read the ESP's FAT volume id — refusing to continue"
fi

# The ESP is normally mounted nowhere on this layout, so mount it on demand.
esp_mnt="" esp_mnt_is_ours=0
mount_esp_rw() {
  # Idempotent: a second call while we already hold the mount must not forget that the tempdir is
  # ours to remove, or unmount_esp leaves it behind.
  [[ -z $esp_mnt ]] || return 0
  esp_mnt="$(findmnt -no TARGET --source "$esp_dev" 2>/dev/null | head -1 || true)"
  if [[ -n $esp_mnt ]]; then
    mount -o remount,rw "$esp_mnt" 2>/dev/null || true
  else
    esp_mnt="$(mktemp -d)"
    esp_mnt_is_ours=1
    mount "$esp_dev" "$esp_mnt" || die "could not mount $esp_dev"
  fi
}
unmount_esp() {
  [[ -n $esp_mnt ]] || return 0
  sync
  umount "$esp_mnt" || die "could not unmount the ESP at $esp_mnt — close anything using it"
  if (( esp_mnt_is_ours )); then
    rmdir "$esp_mnt"
  fi
  esp_mnt=""
  esp_mnt_is_ours=0
}

# 1) Does the table still need rewriting? Re-running after a partial run must not redo this.
esp_sectors="$(gpt_field "$esp_dev" size "$table")"
need_table_rewrite=0
new_sectors="$esp_sectors"
if (( PRUNE_ONLY )); then
  echo "==> --prune-only: leaving the partition table and $esp_dev alone"
elif gpt_field "$ABSORB" start "$table" >/dev/null 2>&1; then
  [[ -b $ABSORB ]] || die "$ABSORB is in the partition table but not a block device"
  [[ "/dev/$(lsblk -no PKNAME "$ABSORB")" == "$disk" ]] || die "$ABSORB is not on $disk"
  [[ $ABSORB != "$esp_dev" ]] || die "refusing to absorb the ESP into itself"

  absorb_mnt="$(findmnt -no TARGET --source "$ABSORB" 2>/dev/null || true)"
  [[ -z $absorb_mnt ]] || die "$ABSORB is mounted at $absorb_mnt — unmount it first (umount $absorb_mnt)"
  root_src="$(findmnt -no SOURCE / 2>/dev/null || true)"
  sysroot_src="$(findmnt -no SOURCE /sysroot 2>/dev/null || true)"
  for in_use in "$root_src" "$sysroot_src"; do
    [[ $in_use == "$ABSORB" ]] && die "$ABSORB backs the running system — refusing"
  done
  if grep -qs "^$ABSORB[[:space:]]" /proc/swaps; then
    die "$ABSORB is an active swap device — refusing"
  fi
  [[ "$(table_partuuid "$ABSORB")" != "$on_disk_esp_uuid" ]] || \
    die "$ABSORB carries the ESP's PARTUUID — refusing"

  new_sectors="$(gpt_absorb_size "$esp_dev" "$ABSORB" "$table")"
  gpt_absorb_table "$esp_dev" "$ABSORB" "$new_sectors" "$table" >"$new_table"
  need_table_rewrite=1
  echo "==> $esp_dev: $(mib "$esp_sectors") MiB -> $(mib "$new_sectors") MiB (absorbing $ABSORB)"
else
  echo "==> $ABSORB is already gone from the partition table; $esp_dev is $(mib "$esp_sectors") MiB"
fi

if (( DRY_RUN )); then
  if (( need_table_rewrite )); then
    echo "==> new partition table:"
    sed 's/^/      /' "$new_table"
    echo "==> $ABSORB currently holds:"
    probe="$(mktemp -d)"
    if mount -o ro "$ABSORB" "$probe" 2>/dev/null; then
      ls -A "$probe" | sed 's/^/      /' || true
      umount "$probe"
    else
      echo "      (could not mount read-only to list — $(blkid -o value -s TYPE "$ABSORB" 2>/dev/null || echo 'no filesystem'))"
    fi
    rmdir "$probe"
  fi
  if [[ -b $esp_dev ]]; then
    echo "==> current boot entry kargs (the ESP's own volume id is ${esp_volid:-unknown}):"
    mount_esp_rw
    grep -rh 'boot=UUID=\|mount-extra' "$esp_mnt/loader/entries" 2>/dev/null | sed 's/^/      /' \
      || echo "      (none)"
    unmount_esp
  else
    echo "==> boot entries cannot be read until the kernel has the ESP's device node back" >&2
  fi
  if [[ -b $esp_dev ]]; then
    mount_esp_rw
    partials="$(esp_partial_bls_dirs "$esp_mnt")"
    if [[ -n $partials ]]; then
      echo "==> half-written boot entries that would be pruned:"
      printf '      %s\n' $partials
    else
      echo "==> no half-written boot entries to prune"
    fi
    unmount_esp
  fi
  echo
  echo "==> --dry-run: nothing was written."
  exit 0
fi

# 0) Boot entries first — nothing below may leave a karg naming a partition that stops existing.
echo "==> checking boot entries before anything is destroyed"
mount_esp_rw
if esp_repoint_entries "$esp_mnt" "$esp_volid"; then
  echo "==> boot entries updated"
else
  echo "==> boot entries already reference only the ESP"
fi
unmount_esp

# 2) Rewrite the table, then make the kernel adopt it.
if (( need_table_rewrite )); then
  if (( ! ASSUME_YES )); then
    echo
    echo "    This DESTROYS $ABSORB and later REFORMATS $esp_dev."
    echo "    The ESP is snapshotted to $BACKUP_DIR first — copy it off this machine before"
    echo "    continuing; if the write goes wrong the backup is only reachable from macOS 1TR."
    read -r -p "    Type GROW to continue: " reply
    [[ $reply == "GROW" ]] || die "aborted"
  fi

  echo "==> writing the new partition table"
  sfdisk --no-reread "$disk" <"$new_table"

  # Verify from the DISK, not from the kernel: BLKRRPART fails whenever any partition on this disk
  # is mounted (it always is — the root filesystem lives here), so the kernel's view lags behind.
  sfdisk -d "$disk" >"$table"
  after_uuid="$(table_partuuid "$esp_dev")"
  [[ ${after_uuid,,} == "${esp_uuid,,}" ]] || \
    die "FATAL: the GPT now says $esp_dev is ${after_uuid:-none}, not $esp_uuid. The Asahi device
  tree points m1n1 at the old one. Restore it before rebooting:
    sfdisk --part-uuid $disk $esp_partno $esp_uuid"
  echo "==> table written; ESP PARTUUID preserved ($esp_uuid)"

  # Make the kernel adopt it: drop the absorbed partition before updating the ESP, or the resize
  # is rejected for overlapping a partition the kernel still believes in.
  sfdisk -d "$disk" >"$table"
  reconcile_kernel_partitions "$disk"
fi

# 3) Grow the filesystem to fill the partition.
want_bytes=$(( new_sectors * sector_size ))
kernel_bytes="$(blockdev --getsize64 "$esp_dev")"
if (( kernel_bytes < want_bytes )); then
  echo >&2
  echo "The partition table is correct on disk, but the kernel still sees $esp_dev as" >&2
  echo "$(( kernel_bytes / 1024 / 1024 )) MiB instead of $(mib "$new_sectors") MiB — it could not re-read the table while this" >&2
  echo "disk carries the mounted root filesystem." >&2
  echo >&2
  echo "Rebooting is safe now: the boot entries no longer name the absorbed partition." >&2
  echo "  sudo reboot" >&2
  echo "  sudo $0 --absorb $ABSORB     # re-run; it picks up from here" >&2
  exit 2
fi

mount_esp_rw
fs_bytes="$(df -B1 --output=size "$esp_mnt" | tail -1 | tr -dc '0-9')"
if (( fs_bytes * 100 / want_bytes >= 95 )); then
  echo "==> the ESP filesystem already fills the partition ($(( fs_bytes / 1024 / 1024 )) MiB) — nothing to do"
else
  esp_backup "$esp_mnt" "$BACKUP_DIR"
  [[ -e $BACKUP_DIR/m1n1/boot.bin ]] || \
    die "$BACKUP_DIR/m1n1/boot.bin is missing — that backup is not the OS ESP, refusing to reformat"
  echo "==> backed up $esp_mnt -> $BACKUP_DIR (label='${esp_label:-none}', volume id=$esp_volid)"
  unmount_esp

  if (( ! ASSUME_YES )); then
    echo
    echo "    About to REFORMAT $esp_dev ($(mib "$new_sectors") MiB) and restore $BACKUP_DIR onto it."
    read -r -p "    Type GROW to continue: " reply
    [[ $reply == "GROW" ]] || die "aborted — the ESP is untouched and the backup is at $BACKUP_DIR"
  fi

  echo "==> mkfs.vfat on the grown ESP"
  mkfs_args=(-F 32 -i "${esp_volid//-/}")
  if [[ -n $esp_label ]]; then
    mkfs_args+=(-n "$esp_label")
  fi
  mkfs.vfat "${mkfs_args[@]}" "$esp_dev"

  mount_esp_rw
  cp -a "$BACKUP_DIR/." "$esp_mnt/"
  esp_repoint_entries "$esp_mnt" "$esp_volid" || true
fi

# An interrupted upgrade leaves <ESP>/EFI/Linux/bootc_composefs-<id>/ with vmlinuz and no initrd,
# and bootc hashes BOTH halves of EVERY such directory before it writes anything — so one corpse
# fails every future upgrade with "Computing boot digest for Type1 entries: Opening initrd: No such
# file or directory", no matter how much room the ESP now has. The backup/restore above preserves
# it faithfully, which is exactly why this runs after the restore rather than before the backup.
mount_esp_rw
if esp_prune_partial_bls "$esp_mnt"; then
  echo "==> pruned half-written boot entries"
else
  echo "==> no half-written boot entries to prune"
fi

# Verify. An ESP that mounts but has lost m1n1 stage 2 is a machine that does not come back.
fail=0
for want in m1n1/boot.bin EFI/BOOT/BOOTAA64.EFI; do
  [[ -e $esp_mnt/$want ]] || { echo "MISSING after restore: $want" >&2; fail=1; }
done
while read -r stray; do
  [[ -n $stray ]] || continue
  echo "boot entry still references a non-ESP partition: $stray" >&2
  fail=1
done < <(grep -rhoE 'systemd\.mount-extra=UUID=[^ ]+' "$esp_mnt/loader/entries" 2>/dev/null || true)
while read -r stray; do
  [[ -n $stray ]] || continue
  echo "half-written boot entry survived the prune: $stray" >&2
  fail=1
done < <(esp_partial_bls_dirs "$esp_mnt")

usable="$(esp_usable_bytes "$esp_mnt")"
payload="$(esp_payload_bytes)"
esp_capacity_report "$usable" "$(esp_required_bytes "$payload")" "$payload" || \
  echo "    still short — the ESP grew but not enough for two deployments." >&2
unmount_esp
(( fail == 0 )) || die "verification FAILED — restore from $BACKUP_DIR before rebooting"

echo
if (( PRUNE_ONLY )); then
  echo "==> DONE. $esp_dev left as it was ($(mib "$esp_sectors") MiB); run: sudo bootc upgrade"
else
  echo "==> DONE. $esp_dev is $(mib "$new_sectors") MiB, PARTUUID unchanged ($esp_uuid)."
  echo "    Backup kept at $BACKUP_DIR. Reboot, then run: sudo bootc upgrade"
fi
