#!/bin/bash

# omarchy:summary=Install T3 Code and point it at the Omarchy palette

set -e

T3CODE_HOME="${T3CODE_HOME:-$HOME/.t3}"
T3CODE_STATE_DIR="$T3CODE_HOME/userdata"

echo "Installing T3 Code..."
# T3 Code ships as the official npm package `t3` (the self-contained aarch64
# binary via the @t3code/t3-linux-arm64 optional dependency). There is no Arch
# package and no Flathub build, so mise builds it a user-scoped wrapper — the
# aarch64 Linux path, matching how the fork installs its other npm CLIs.
omarchy-mise-install npm:t3 t3

echo "Matching T3 Code to the current theme..."
mkdir -p "$T3CODE_STATE_DIR"

# An updated user's current theme may have been staged before this template existed.
if [[ ! -f $HOME/.local/state/omarchy/current/theme/t3code.json ]]; then
  omarchy-theme-refresh
fi

omarchy-theme-set-t3code

# Select the published palette before the app's first launch. This is also the
# first `t3` invocation, so the mise wrapper materializes the install here.
t3 theme set omarchy --base-dir "$T3CODE_HOME"

echo "Opening T3 Code..."
setsid uwsm-app -- t3 >/dev/null 2>&1 &

echo ""
echo "T3 Code has been installed."
