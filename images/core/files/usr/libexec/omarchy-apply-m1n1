#!/usr/bin/env bash
# Refresh the Asahi PREBOOT layer in the OS EFI System Partition after an image update:
#   <ESP>/m1n1/boot.bin   (m1n1 stage 2 + U-Boot + devicetree)   -> via update-m1n1
#   <ESP>/vendorfw/...     (per-machine Apple firmware)           -> via asahi-fwextract (opt-in)
#
# This is PLAIN bootc — no rpm-ostree, no bootupd. bootc owns the OS bootloader
# (/EFI/BOOT/BOOTAA64.EFI, e.g. systemd-boot) but is NOT Asahi-aware, so it never refreshes the
# preboot layer. On mutable Asahi these refresh automatically on kernel/firmware updates; on
# bootc they don't.
#
# Why boot.bin can't be bypassed: m1n1 patches the devicetree dynamically for THIS machine, so
# the DT must flow through boot.bin — you can't hand systemd-boot a static image DTB instead.
# So a kernel DT change (e.g. the 6.19 USB DT) with a stale boot.bin breaks hardware. Policy:
# refresh boot.bin only when the kernel changes (leave it in place otherwise); refresh vendorfw
# only when its package changes (and only if opted in).
#
# Reboot semantics (inherent to Asahi): after `bootc upgrade` + reboot you're on the new kernel
# but boot.bin still holds the old DT; this rewrites it, effective on the NEXT boot. Set
# OMARCHY_M1N1_AUTOREBOOT=1 (in /etc/default/omarchy-m1n1) to auto-reboot when it changed.
set -uo pipefail

[ "$(uname -m)" = aarch64 ] || exit 0
command -v update-m1n1 >/dev/null 2>&1 || exit 0     # not an Asahi machine

state=/var/lib/omarchy; mkdir -p "$state"
changed=0

# --- m1n1 stage 2 + devicetree: refresh once per kernel, else leave in place ---
kstamp="$state/m1n1-applied"; cur="$(uname -r)"
if [ "$(cat "$kstamp" 2>/dev/null)" != "$cur" ]; then
  echo "apply-m1n1: refreshing m1n1 + devicetree for kernel $cur"
  if update-m1n1; then printf '%s\n' "$cur" >"$kstamp"; changed=1
  else echo "apply-m1n1: update-m1n1 FAILED" >&2; exit 1; fi
else
  echo "apply-m1n1: boot.bin already current for $cur (left in place)"
fi

# --- vendor firmware: leave in place by default; opt-in refresh when the extractor updates ---
# asahi-fwextract re-derives vendorfw from this machine's Apple firmware. Its exact invocation
# varies, so it is OPT-IN (OMARCHY_FWEXTRACT=1) and best-effort; the default is leave-in-place
# (the install wrapper preserves the existing vendorfw, which changes very rarely).
if command -v asahi-fwextract >/dev/null 2>&1; then
  fstamp="$state/fwextract-applied"
  fver="$(rpm -q --qf '%{VERSION}-%{RELEASE}' asahi-fwextract 2>/dev/null || echo unknown)"
  if [ "$(cat "$fstamp" 2>/dev/null)" != "$fver" ]; then
    if [ "${OMARCHY_FWEXTRACT:-0}" = 1 ]; then
      echo "apply-m1n1: refreshing vendor firmware (asahi-fwextract $fver)"
      if asahi-fwextract; then printf '%s\n' "$fver" >"$fstamp"
      else echo "apply-m1n1: asahi-fwextract failed — vendorfw left in place" >&2; fi
    else
      echo "apply-m1n1: vendorfw left in place (asahi-fwextract $fver available; set OMARCHY_FWEXTRACT=1 to refresh)"
    fi
  fi
fi

if [ "$changed" = 1 ]; then
  if [ "${OMARCHY_M1N1_AUTOREBOOT:-0}" = 1 ]; then
    echo "apply-m1n1: rebooting to boot with the refreshed devicetree"; systemctl reboot
  else
    echo "apply-m1n1: boot.bin refreshed — reboot once to apply (OMARCHY_M1N1_AUTOREBOOT=1 to automate)"
  fi
fi
